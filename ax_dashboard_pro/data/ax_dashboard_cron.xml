<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_ax_dashboard_snapshots" model="ir.cron">
        <field name="name">Dashboard: KPI snapshots, alerts and anomaly checks</field>
        <field name="model_id" ref="model_ax_dashboard_item"/>
        <field name="state">code</field>
        <field name="code">model._cron_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record id="cron_ax_dashboard_emails" model="ir.cron">
        <field name="name">Dashboard: send scheduled email reports</field>
        <field name="model_id" ref="model_ax_dashboard_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
