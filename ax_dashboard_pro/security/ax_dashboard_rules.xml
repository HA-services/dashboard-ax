    <record id="rule_dashboard_user_read" model="ir.rule">
        <field name="name">Dashboard: visible ones</field>
        <field name="model_id" ref="model_ax_dashboard"/>
        <field name="groups" eval="[(4, ref('group_ax_dashboard_user'))]"/>
        <field name="domain_force">['|', '|', '|', '|', ('owner_id', '=', user.id), ('user_ids', 'in', [user.id]), ('edit_user_ids', 'in', [user.id]), ('group_ids', 'in', user.groups_id.ids), ('shared_all', '=', True)]</field>
