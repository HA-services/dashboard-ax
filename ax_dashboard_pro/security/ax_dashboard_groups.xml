<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ax_dashboard" model="ir.module.category">
        <field name="name">AXSync Dashboard Pro</field>
        <field name="sequence">91</field>
    </record>

    <record id="res_groups_privilege_ax_dashboard" model="res.groups.privilege">
        <field name="name">AXSync Dashboard Pro</field>
        <field name="sequence">91</field>
        <field name="category_id" ref="module_category_ax_dashboard"/>
    </record>

    <record id="group_ax_dashboard_user" model="res.groups">
        <field name="name">Dashboard User</field>
        <field name="privilege_id" ref="res_groups_privilege_ax_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can open the dashboards shared with them, filter, export items and comment.</field>
    </record>

    <record id="group_ax_dashboard_builder" model="res.groups">
        <field name="name">Dashboard Builder</field>
        <field name="privilege_id" ref="res_groups_privilege_ax_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_ax_dashboard_user'))]"/>
        <field name="comment">Can create dashboards and items, share them, use templates and the AI assistant.</field>
    </record>

    <record id="group_ax_dashboard_manager" model="res.groups">
        <field name="name">Dashboard Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_ax_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_ax_dashboard_builder'))]"/>
        <field name="comment">Manages all dashboards, SQL and external connections, AI settings and the logs.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ax_dashboard_manager'))]"/>
    </record>
</odoo>
