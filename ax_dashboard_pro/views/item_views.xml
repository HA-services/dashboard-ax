<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ax_dashboard_item_form" model="ir.ui.view">
        <field name="name">ax.dashboard.item.form</field>
        <field name="model">ax.dashboard.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard item">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Sales this month"/></h1>
                    </div>
                    <group>
                        <group string="What to show">
                            <field name="dashboard_id"/>
                            <field name="item_type"/>
                            <field name="source_type"/>
                            <field name="code" invisible="item_type != 'kpi'"/>
                        </group>
                        <group string="Position on the 12 column grid">
                            <field name="grid_x"/>
                            <field name="grid_y"/>
                            <field name="grid_w"/>
                            <field name="grid_h"/>
                        </group>
                    </group>
                    <field name="model_name" invisible="1"/>
                    <notebook>
                        <page string="Data" name="data" invisible="item_type == 'todo'">
                            <group invisible="source_type != 'model'">
                                <group string="Source">
                                    <field name="model_id" options="{'no_create': True}"/>
                                    <field name="date_field_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Measure" invisible="item_type == 'list'">
                                    <field name="aggregate"/>
                                    <field name="measure_field_id" options="{'no_create': True}" invisible="aggregate == 'count'"/>
                                    <field name="measure2_field_id" options="{'no_create': True}" invisible="chart_type != 'scatter' or item_type != 'chart'"/>
                                </group>
                                <group string="Grouping" invisible="item_type != 'chart'">
                                    <field name="groupby_field_id" options="{'no_create': True}"/>
                                    <field name="groupby2_field_id" options="{'no_create': True}"/>
                                    <field name="date_interval"/>
                                    <field name="sort_by"/>
                                    <field name="sort_dir"/>
                                    <field name="limit"/>
                                </group>
                                <group string="Rows" invisible="item_type != 'list'">
                                    <field name="list_field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="list_order"/>
                                    <field name="limit"/>
                                </group>
                            </group>
                            <group string="Filter records" invisible="source_type != 'model'">
                                <field name="domain" widget="domain" options="{'model': 'model_name'}" nolabel="1" colspan="2"/>
                            </group>
                            <group invisible="source_type != 'file'" string="Excel or CSV file">
                                <field name="data_file" filename="data_filename"/>
                                <field name="data_filename" invisible="1"/>
                                <field name="file_groupby" invisible="item_type != 'chart'"/>
                                <field name="file_measure" invisible="item_type == 'list'"/>
                                <field name="aggregate" invisible="item_type == 'list'"/>
                                <field name="file_columns" invisible="item_type != 'list'"/>
                                <field name="limit"/>
                                <p class="text-muted" colspan="2">The first row holds the column names. The first sheet of an .xlsx workbook is read. Date filters do not apply to files. For a map, the group column holds two letter country codes such as FR or US.</p>
                            </group>
                            <group invisible="source_type != 'formula'" string="Formula">
                                <field name="formula" placeholder="{sales} / {orders}"/>
                                <p class="text-muted" colspan="2">Use the code of other KPI items of this dashboard in braces. Allowed: numbers, + - * / % ** and brackets.</p>
                            </group>
                            <group invisible="source_type not in ('sql', 'external')" string="Query">
                                <field name="connection_id" invisible="source_type != 'external'"/>
                                <field name="sql_query" colspan="2" nolabel="1" placeholder="SELECT partner_id::text AS label, SUM(amount_total) AS value FROM sale_order WHERE date_order::date &gt;= {{date_from}} GROUP BY 1 ORDER BY 2 DESC"/>
                                <field name="limit"/>
                            </group>
                        </page>
                        <page string="Display" name="display" invisible="item_type == 'todo'">
                            <group>
                                <group string="Chart" invisible="item_type != 'chart'">
                                    <field name="chart_type"/>
                                    <field name="color_scheme"/>
                                    <field name="custom_colors" invisible="color_scheme != 'custom'"/>
                                    <field name="show_legend"/>
                                    <field name="show_labels"/>
                                </group>
                                <group string="Tile" invisible="item_type != 'kpi'">
                                    <field name="kpi_icon"/>
                                    <field name="kpi_color" widget="color"/>
                                    <field name="target_value"/>
                                </group>
                                <group string="Compare and forecast">
                                    <field name="compare_mode"/>
                                    <field name="forecast_periods" invisible="item_type != 'chart' or chart_type not in ('line', 'area', 'bar')"/>
                                </group>
                                <group string="Number format">
                                    <field name="number_format"/>
                                    <field name="decimals"/>
                                    <field name="prefix"/>
                                    <field name="suffix"/>
                                    <field name="currency_id"/>
                                </group>
                                <group string="Help">
                                    <field name="description"/>
                                </group>
                            </group>
                        </page>
                        <page string="Drill-down" name="drill" invisible="item_type != 'chart'">
                            <group>
                                <field name="drill_path" placeholder="user_id, partner_id"/>
                            </group>
                            <p class="text-muted">When a user clicks a bar or a slice, the chart opens the next field of this list for that group. After the last field it opens the matching records.</p>
                        </page>
                        <page string="Alerts" name="alerts" invisible="item_type != 'kpi'">
                            <group>
                                <group string="Thresholds">
                                    <field name="alert_enabled"/>
                                    <field name="use_alert_min" invisible="not alert_enabled"/>
                                    <field name="alert_min" invisible="not alert_enabled or not use_alert_min"/>
                                    <field name="use_alert_max" invisible="not alert_enabled"/>
                                    <field name="alert_max" invisible="not alert_enabled or not use_alert_max"/>
                                </group>
                                <group string="Anomalies and history">
                                    <field name="snapshot_enabled"/>
                                    <field name="anomaly_enabled"/>
                                    <field name="snapshot_preset"/>
                                    <field name="alert_user_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <field name="alert_ids" readonly="1">
                                <tree>
                                    <field name="create_date"/>
                                    <field name="kind"/>
                                    <field name="message"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="To-do lines" name="todo" invisible="item_type != 'todo'">
                            <field name="todo_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="done"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Performance" name="perf">
                            <group>
                                <field name="last_load_ms"/>
                                <field name="avg_load_ms"/>
                                <field name="load_count"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ax_dashboard_item_list" model="ir.ui.view">
        <field name="name">ax.dashboard.item.list</field>
        <field name="model">ax.dashboard.item</field>
        <field name="arch" type="xml">
            <tree string="Items">
                <field name="dashboard_id"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="source_type"/>
                <field name="model_id"/>
                <field name="avg_load_ms"/>
                <field name="load_count"/>
                <field name="alert_enabled"/>
            </tree>
        </field>
    </record>

    <record id="view_ax_dashboard_item_search" model="ir.ui.view">
        <field name="name">ax.dashboard.item.search</field>
        <field name="model">ax.dashboard.item</field>
        <field name="arch" type="xml">
            <search string="Items">
                <field name="name"/>
                <field name="dashboard_id"/>
                <field name="model_id"/>
                <filter string="KPI tiles" name="kpi" domain="[('item_type', '=', 'kpi')]"/>
                <filter string="Charts" name="chart" domain="[('item_type', '=', 'chart')]"/>
                <filter string="Lists" name="list" domain="[('item_type', '=', 'list')]"/>
                <filter string="With alerts" name="alerts" domain="[('alert_enabled', '=', True)]"/>
                <group expand="0" string="Group by">
                    <filter string="Dashboard" name="group_dashboard" context="{'group_by': 'dashboard_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'item_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ax_dashboard_item" model="ir.actions.act_window">
        <field name="name">All items</field>
        <field name="res_model">ax.dashboard.item</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
