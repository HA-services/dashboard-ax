<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ax_dashboard_import_wizard" model="ir.ui.view">
        <field name="name">ax.dashboard.import.wizard.form</field>
        <field name="model">ax.dashboard.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import a dashboard">
                <group invisible="warnings">
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <group invisible="not warnings">
                    <div class="alert alert-warning" role="alert">The dashboard was imported. Some items could not be created:</div>
                    <field name="warnings" nolabel="1" colspan="2"/>
                    <field name="dashboard_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary" invisible="warnings"/>
                    <button string="Open dashboard" name="action_open_dashboard" type="object" class="btn-primary" invisible="not warnings"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ax_dashboard_import" model="ir.actions.act_window">
        <field name="name">Import a dashboard</field>
        <field name="res_model">ax.dashboard.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_ax_dashboard_ai_wizard" model="ir.ui.view">
        <field name="name">ax.dashboard.ai.wizard.form</field>
        <field name="model">ax.dashboard.ai.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate with AI">
                <group invisible="warnings">
                    <field name="mode" widget="radio"/>
                    <field name="dashboard_id" invisible="mode != 'item'"/>
                    <field name="model_id" options="{'no_create': True}"/>
                    <field name="keyword"/>
                    <field name="prompt" placeholder="Show sales by month, my top 10 customers and unpaid invoices"/>
                </group>
                <group invisible="not warnings">
                    <div class="alert alert-warning" role="alert">Some proposed items were skipped:</div>
                    <field name="warnings" nolabel="1" colspan="2"/>
                    <field name="result_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Generate" name="action_generate" type="object" class="btn-primary" invisible="warnings"/>
                    <button string="Open dashboard" name="action_open_result" type="object" class="btn-primary" invisible="not warnings"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ax_dashboard_ai" model="ir.actions.act_window">
        <field name="name">Generate with AI</field>
        <field name="res_model">ax.dashboard.ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_ax_dashboard_move_wizard" model="ir.ui.view">
        <field name="name">ax.dashboard.move.wizard.form</field>
        <field name="model">ax.dashboard.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Move item">
                <group>
                    <field name="item_id" readonly="1"/>
                    <field name="dashboard_id"/>
                </group>
                <footer>
                    <button string="Move" name="action_move" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ax_dashboard_move" model="ir.actions.act_window">
        <field name="name">Move item</field>
        <field name="res_model">ax.dashboard.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
